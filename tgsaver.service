[Unit]
Description=TgSaver - Telegram message archiver bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 【需修改】改成你实际的用户名和路径
User=tgsaver
Group=tgsaver
WorkingDirectory=/opt/tgsaver
ExecStart=/opt/tgsaver/venv/bin/python /opt/tgsaver/bot.py

Restart=always
RestartSec=5
# 反复崩溃时别把系统拖垮
StartLimitIntervalSec=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tgsaver

# 加固：这些不影响功能，但能显著缩小被入侵后的破坏面
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tgsaver
# 大文件中转用的临时目录。交给 systemd 管：每次启动前自动创建
# /var/cache/tgsaver 并把属主设成服务用户，在 ProtectSystem=strict 下也自动可写。
# 以前用 /tmp/tgsaver，系统重启后 /tmp 被清空，目录不存在，
# 服务在建挂载命名空间时就失败（status=226/NAMESPACE）。
CacheDirectory=tgsaver
CacheDirectoryMode=0750
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
