# ============================================================
#  机密 —— 泄露任何一项都等同于交出你的 Telegram 账号
# ============================================================

# 配置文件，含 API_HASH / BOT_TOKEN / SECRET_KEY
.env
.env.*
!.env.example

# 数据库，含加密后的 session 与用户记录
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Telethon session 文件（login.py 用的是 StringSession 存库，
# 但手工调试时可能生成这些，一并挡掉）
*.session
*.session-journal

# 加密密钥的任何独立备份
*.key
secrets/

# ============================================================
#  运行时产物
# ============================================================
tmp/
/tmp/tgsaver/
*.log
logs/

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
