# ============================================================
#  TgSaver 配置文件
#  复制为 .env 后填写。务必 chmod 600 .env
# ============================================================

# ---------- 【必填 1】Telegram API 凭据 ----------
# 获取地址: https://my.telegram.org  ->  API development tools
# 用你的大号登录后创建一个 application，随便填名字即可
API_ID=
API_HASH=

# ---------- 【必填 2】Bot Token ----------
# 找 @BotFather -> /newbot -> 拿到形如 123456:ABC-DEF... 的 token
BOT_TOKEN=

# ---------- 【必填 3】你自己的数字 user id ----------
# 找 @userinfobot 发一句话，它会回你的 id（纯数字）
OWNER_ID=

# ---------- 【必填 4】中转频道 id ----------
# 步骤:
#   1. 用大号新建一个【私有频道】(New Channel -> Private)
#   2. 频道 -> Administrators -> Add Admin -> 把你的 bot 加进去
#      权限至少勾选: Post Messages / Delete Messages
#   3. 在频道里随便发一条消息，复制该消息链接 t.me/c/1234567890/2
#      则此处填 -1001234567890  （即 -100 前缀 + 链接里那串数字）
RELAY_CHANNEL_ID=

# ---------- 【必填 5】Session 加密密钥 ----------
# 运行 `python genkey.py` 生成，把输出整行粘到这里
SECRET_KEY=


# 推文呈现方式：
#   auto     先问 Telegram 预览里有没有媒体：齐全就发预览，缺了就发原始媒体（默认）
#   preview  强制预览：文字 + fxtwitter 大图预览。最快、零流量，但长视频可能不出现
#   media    强制发送原始图片视频，多图是独立相册，可单独保存
TWEET_MODE=auto

# auto 模式下等 Telegram 生成预览的最长秒数，超时就改发原始媒体。
# 多图时 fxtwitter 要现场拼图，可能要十几秒。
TWEET_PREVIEW_TIMEOUT=20


# 推文末尾 "via 署名" 那一行，可选。留空则不显示。
# 例：TWEET_SIGNATURE_TEXT=@我的频道  TWEET_SIGNATURE_URL=https://t.me/xxx
TWEET_SIGNATURE_TEXT=
TWEET_SIGNATURE_URL=


# ============================================================
#  以下均有默认值，不改也能跑
# ============================================================

# 数据库路径
DB_PATH=./tgsaver.db

# 临时目录（路径 C 大文件落盘用）。需与实际磁盘余量匹配
TMP_DIR=/tmp/tgsaver

# 单文件上传上限（字节）。普通账号 2GB，Premium 可改 4GB
MAX_UPLOAD_SIZE=2097152000

# 超过此大小的受保护文件改走落盘模式（字节），默认 1GB
# 设为 0 则全部强制流式（不占磁盘，但失败无法断点重试）
STREAM_MAX_SIZE=1073741824

# 落盘前要求的磁盘余量倍数
DISK_HEADROOM=1.2

# 快通道并发（服务端直转，几乎零成本）
FAST_CONCURRENCY=4

# 慢通道全局并发（受保护内容转存）
SLOW_CONCURRENCY=2

# 落盘路径同时最多几个任务（受 TMP_DIR 容量限制，建议 1）
DISK_CONCURRENCY=1

# session 空闲多久后断开连接（秒）
SESSION_IDLE_TIMEOUT=600

# 同时保持连接的 session 上限（多用户时生效）
SESSION_POOL_SIZE=20

# 进度条刷新间隔（秒），太小会触发 Telegram 限流
PROGRESS_INTERVAL=5

# 任务最大重试次数
MAX_RETRIES=3

# 日志级别 DEBUG/INFO/WARNING
LOG_LEVEL=INFO

# FxTwitter API 地址（推文功能用）。默认用官方公开实例，
# 限速每 IP 每分钟 1000 次。自建了 FxEmbed 实例的话改这里。
# https://github.com/FxEmbed/FxEmbed
FXTWITTER_API=https://api.fxtwitter.com

# 生成预览用的域名，一般不用改
FXTWITTER_HOST=fxtwitter.com
